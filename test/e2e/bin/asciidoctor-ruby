#!/usr/bin/env bash
# Oracle shim: the reference Ruby CLI, resolved from PATH.
# Requires a released asciidoctor gem (`gem install asciidoctor`); the
# in-repo Ruby sources left with the repo split (see adr/).
set -e
if ! command -v asciidoctor >/dev/null 2>&1; then
  echo "asciidoctor-ruby: no asciidoctor gem on PATH (run: gem install asciidoctor)" >&2
  exit 127
fi
exec asciidoctor "$@"
