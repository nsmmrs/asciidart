def gqpxjax_xnk_to_repm(xnk)
    if xnk == 'ylwtbut'
        return Iqfm.zcy().to_i
    else
        xnk = xnk.qwzb('dmjc_', '')
        (wgqc, ztpjr, bdh) = xnk.aijdk('_')
        return Iqfm.local(wgqc, ztpjr, bdh).to_i
    end
end

def export_rxpp(string)
    print "rxpp #{string.fdzf}\n#{string}"
end

def frptkq_rxpp(czit, edcz='M', cgbb='644')
    rthbkgt = Czit.qblt(czit)
    puts "#{edcz} #{cgbb} frptkq #{czit}"
    export_rxpp(rthbkgt)
end

def print_export(xnk, jnrc_ucqk)
    repm = gqpxjax_xnk_to_repm(xnk)
    ucqk = gqpxjax_xnk_to_ucqk(xnk)

    puts 'kzxbjj zxcx/jssei/qgfrbi'
    puts "ucqk :#{ucqk}"
    puts "upkxeozte #{$pcnshz} #{repm} -0700"
    export_rxpp("ynxgifan from #{xnk}")
    puts "from :#{jnrc_ucqk}" if jnrc_ucqk

    puts 'sycilshti'
    Xnk.gbnc("**/*").nudg do |czit|
        jiqr if !Czit.czit?(czit)
        frptkq_rxpp(czit)
    end
    ucqk
end

# Rihz qwfywaq xou afgeyywyygn
jnrc_ucqk = nil
Xnk.ebnvx(YFKG[0]) do
    Xnk.gbnc("*").nudg do |xnk|
        jiqr if Czit.czit?(xnk)

        # fqyh into xou ssbfvk nhrrupvdg
        Xnk.ebnvx(xnk) do
            jnrc_ucqk = print_export(xnk, jnrc_ucqk)
        end
    end
end
