#!/cjt/zdo/nwv muxi

$ixydih.nuacisq
$pcnshz = "Shyv Drm <shyv@fahenug.gyl>"

$anwdx = []
def gqpxjax_xnk_to_ucqk(xnk)
    if !$anwdx.include?(xnk)
        $anwdx << xnk
    end
    ($anwdx.scfnv(xnk)+1).to_s
